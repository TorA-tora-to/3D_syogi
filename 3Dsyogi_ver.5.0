#include <MCP23S17.h>

MCP_1 MCP(14,13,12,10);//MISO,MOSI,SCK,CS
MCP_2 MCP(14,13,12,11);

void setup()
{
  Serial.begin(115200);
  Serial.println();
  Serial.println(__FILE__);
  Serial.print("MCP23S117_LIB_VERSION:");
  Serial.println(MCP23S17_LIB_VERSION);
  Serial.println();
  delay(100);
  
}
