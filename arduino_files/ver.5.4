/*
  MCP23S17:https://github.com/RobTillaart/MCP23S17
  MCP23S08:https://github.com/RobTillaart/MCP23S08
  74HC4511:https://github.com/Andy4495/LED744511/tree/main
*/
#include "MCP23S17.h"
#include "MCP23S08.h"
#include "LED744511.h"

const int CLK=12;
const int PIN_MOSI=13;
const int PIN_MISO=14;
const int CS1=11;//Vcc
const int CS2=10;//GND
const int CS3=21;
const int SD=9;
const int data=17;
const int rightdata=16;
const int leftdata=15;
const int switchpin=7;

int i,x,y;
int turn=0;
int koma[9][9]={0};
int koma_buckup[9][9]={0};//バックアップによって差分を取り、パソコンに送る。
int mochigoma[2][3][3]={0};
int sente;
double sensor_data=0;
double right_sd;
double left_sd=0;

MCP23S17 MCP_1(CS1,PIN_MISO,PIN_MOSI,CLK);//CS,SO,SI,CLK
MCP23S17 MCP_2(CS2,PIN_MISO,PIN_MOSI,CLK);
MCP23S08 MCP_3(CS3,PIN_MISO,PIN_MOSI,CLK);
LED744511 LED(14,15,16,17,47);

void setup() {
  Serial.begin(115200);
  Serial.println();
  Serial.println(__FILE__);
  Serial.print("MCP23S17_LIB_VERSION: ");
  Serial.println(MCP23S17_LIB_VERSION);
  Serial.print("MCP23S08_LIB_VERSION: ");
  Serial.println(MCP23S08_LIB_VERSION);
  Serial.println();
  delay(100);
  for(i=0;i<10;i++)
  {
    LED.writeBCD(i);
    delay(100);
  }
  LED.writeBCD(0);
  SPI.begin();

  bool b = MCP_1.begin();
  bool c = MCP_2.begin();
  bool d = MCP_3.begin();
  Serial.print("MCP_1");
  Serial.println(b ? "true" : "false");
  delay(100);
  Serial.print("MCP_2");
  Serial.println(c ? "true" : "false");
  delay(100);
  Serial.print("MCP_3");
  Serial.println(d ? "true" : "false");
  delay(100);
  Serial.println("DIPスイッチ1を利用して、手番を設定して下さい");
  LED.writeBCD(1);
  for(i=0;i<16;i++)
  {
    MCP_1.write1(i,LOW);
  }
  delay(100);
  for(i=0;i<16;i++)
  {
    MCP_2.write1(i,LOW);
  }
  delay(100);
  for(i=0;i<8;i++)
  {
    MCP_3.write1(i,LOW);
  }
  delay(100);

  pinMode(data,INPUT);//メイン基板センサデータ
  pinMode(rightdata,INPUT);//駒台センサデータ
  pinMode(leftdata,INPUT);
  pinMode(switchpin,INPUT);
  LED.writeBCD(2);
  //DIPスイッチ0番を読み取り、先手後手と駒台の関係を指定する。
  delay(1000);
  sente=MCP_3.read1(0);//HIGHなら、正面が先手(rightkomadaiが先手)
}

int hantei(double data)//読み取り値に応じて駒を判別する
{
  const int gyoku=800;//以下、範囲最下
  const int hisya=770;
  const int kaku=740;
  const int kin=710;
  const int gin=680; 
  const int kei=650;
  const int kyou=620;
  const int fu=590;
  const int nari_fu=410;//以下、範囲最上
  const int nari_kyou=380;
  const int nari_kei=350;
  const int nari_gin=320;
  const int KIN=290;
  const int nari_kaku=260;
  const int nari_hisya=230;
  const int GYOKU=200;

  int out;

  if(data<GYOKU)
  {
    out=-8;
  }
  else if(data<nari_hisya)
  {
    out=-7;
  }
  else if(data<nari_kaku)
  {
    out=-6;
  }
  else if(data<KIN)
  {
    out=-5;
  }
  else if(data<nari_gin)
  {
    out=-4;
  }
  else if(data<nari_kei)
  {
    out=-3;
  }
  else if(data<nari_kyou)
  {
    out=-2;
  }
  else if(data<nari_fu)
  {
    out=-1;
  }
  else if(data>gyoku)
  {
    out=8;
  }
  else if(data>hisya)
  {
    out=7;
  }
  else if(data>kaku)
  {
    out=6;
  }
  else if(data>kin)
  {
    out=5;
  }
  else if(data>gin)
  {
    out=4;
  }
  else if(data>kei)
  {
    out=3;
  }
  else if(data>kyou)
  {
    out=2;
  }
  else if(data>fu)
  {
    out=1;
  }
  else
  {
    out=0;
  }
  return out;
}

void loop() {
  if((turn%2==0&&digitalRead(switchpin)==HIGH)||(turn%2==1&&digitalRead(switchpin)==LOW))
  {
    LED.writeBCD(3);
    //A7~B0~B7(7~15)
    for(i=7;i<16;i++)
    {
      MCP_1.write1(i,LOW);//Vcc,y
      MCP_2.write1(i,HIGH);//GND,x
      delay(2);
    }
    for(i=1;i<4;i++)
    {
      MCP_1.write1(i+3,LOW);//Vcc
      MCP_1.write1(i,HIGH);//GND
      MCP_2.write1(i+3,LOW);
      MCP_2.write1(i,HIGH);
      delay(2);
    }
    delay(100);

    for(y=7;y<16;y++)//盤面センサ
    {
      MCP_1.write1(y,HIGH);
      for(x=7;x<16;x++)
      {
        MCP_2.write1(x,LOW);
        delay(6);//この辺りを複数回実行し、正しいデータを読めるようにする。
        sensor_data=0;
        for(i=0;i<5;i++)
        {
          sensor_data+=analogRead(data);
          delay(2);
        }
        sensor_data/=5;
        delay(5);
        koma[x][y]==hantei(sensor_data);
        if(turn%2==1)//後手は負
        {
          koma[x][y]*=-1;
        }

        delay(2);
        for(i=7;i<16;i++)
        {
          MCP_1.write1(i,LOW);//Vcc
          MCP_2.write1(i,HIGH);//GND
        }
        delay(2);
      }
    }

    for(y=4;y<8;y++)//持ち駒センサ
    {
      MCP_1.write1(y,HIGH);
      MCP_2.write1(y,HIGH);
      for(x=1;x<4;x++)
      {
        MCP_1.write1(x,LOW);
        MCP_2.write1(x,LOW);
        delay(6);//この辺りを複数回実行し、正しいデータを読めるようにする。
        left_sd=0;
        right_sd=0;
        for(i=0;i<5;i++)
        {
          left_sd+=analogRead(leftdata);
          right_sd+=analogRead(rightdata);
          delay(2);
        }
        left_sd/=5;
        right_sd/=5;
        delay(10);

        if(sente==HIGH)
        {
          mochigoma[0][x][y]=-1*hantei(left_sd);//0:left/1:right
          delay(2);
          mochigoma[1][x][y]=hantei(right_sd);
        }
        else
        {
          mochigoma[0][x][y]=-1*hantei(left_sd);//0:left/1:right
          delay(2);
          mochigoma[1][x][y]=hantei(right_sd);
        }
      }
    }

    for(y=0;y<9;y++)
    {
      for(x=0;x<9;x++)
      {
        if(koma[y][x]!=koma_buckup[y][x])
        {
          Serial.printf("%d,%d,%d,%d",turn,x-1,y-1,koma[y][x]);
          koma_buckup[y][x]=koma[y][x];
          delay(2);
        }
      }
    }

    turn++;
  }
  else
  {
    LED.writeBCD(4);
  }
}
