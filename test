#define Vcc1 1
#define Vcc2 2
#define Vcc3 3
#define GND1 4
#define GND2 5
#define GND3 6
#define DATA 7
#define FRD 8

int gyoku=1023;
int hisya=970;
int kaku=920;
int kin=870;
int gin=820;
int kei=770;
int kyou=720;
int fu=670;
int shiki=600;//駒なしと歩の判断閾値
int fu2=420;
int kyou2=370;
int kei2=320;
int gin2=270;
int kin2=220;
int kaku2=170;
int hisya2=120;
int gyoku2=70;
int koma=0;
double mdata=0,mfrd=0;
int turn;   
int x,y,t=0;

int banmen[3][3]={0};
int banmen_b[3][3]={0};

void setup() {
  Serial.begin(115200);
  pinMode(Vcc1,OUTPUT);
  pinMode(Vcc2,OUTPUT);
  pinMode(Vcc3,OUTPUT);
  pinMode(GND1,OUTPUT);
  pinMode(GND2,OUTPUT);
  pinMode(GND3,OUTPUT);
  pinMode(DATA,OUTPUT);
  pinMode(FRD,OUTPUT);
}

int hantei(void)
{
  int gyoku=1023;
  int hisya=970;
  int kaku=920;
  int kin=870;
  int gin=820;
  int kei=770;
  int kyou=720;
  int fu=670;
  int shiki=600;//駒なしと歩の判断閾値
  int fu2=420;
  int kyou2=370;
  int kei2=320;
  int gin2=270;
  int kin2=220;
  int kaku2=170;
  int hisya2=120;
  int gyoku2=70;
  int koma;
  int turn;
  int data=0;
  int frd=0;
  int white=500;
  for(turn=0;turn<5;turn++)
  {
    data+=analogRead(DATA);
    frd+=analogRead(FRD);
  }
  data/=5;
  frd/=5;
  if(mdata<gyoku2)
    {
      koma=-8;  
    }
    else if(mdata<hisya2)
    {
      koma=-7;  
    }
    else if(mdata<kaku2)
    {
      koma=-6;  
    }
    else if(mdata<kin2)
    {
      koma=-5;  
    }
    else if(mdata<gin2)
    {
      koma=-4;  
    }
    else if(mdata<kei2)
    {
      koma=-3;  
    }
    else if(mdata<kyou2)
    {
      koma=-2;  
    }
    else if(mdata<fu2)
    {
      koma=-1;  
    }
    else if(mdata<shiki)
    {
      koma=0;  
    }
    else if(mdata<fu)
    {
      koma=1;
    }
    else if(mdata<kyou)
    {
      koma=2;
    }
    else if(mdata<kei)
    {
      koma=3;
    }
    else if(mdata<gin)
    {
      koma=4;
    }
    else if(mdata<kin)
    {
      koma=5;
    }
    else if(mdata<kaku)
    {
      koma=6;
    }
    else if(mdata<hisya)
    {
      koma=7;
    }
    else if(mdata<gyoku)
    {
      koma=8;
    }

  
    if(mfrd>white)
    {
      if(koma<0)
      {
        koma-=100;
      }
      else if(koma>0)
      {
        koma+=100;
      }
    }
    return koma;  


}



void loop() {
  x=t/3;
  y=t%3;

  digitalWrite(x+1,LOW);
  digitalWrite(y+4,HIGH);
  for(turn=0;turn<3;turn++)
  {
    if(turn!=x)
    {
      digitalWrite(turn+1,HIGH);
    }

    if(turn!=y)
    {
      digitalWrite(turn+4,LOW);
    }
  }
  delay(10);
  
  banmen_b[x][y]=banmen[x][y];
  delay(5);
  banmen[x][y]=hantei();
  delay(5);
  if(banmen[x][y]!=banmen_b[x][y])
  {
    Serial.printf("%d,%d",t,banmen[x][y]);
  }


  t++;
  if(t==9)
  {
    t=0;
  }

}
